# 生产环境配置模板：复制为项目根目录的 .env(已在 .gitignore 中，不要提交)，按需填写。
#   cp deploy/env.example .env && chmod 600 .env && docker compose up -d --build
# 留空的项不启用。改完后 docker compose up -d 重新创建容器即可生效。

# 容器以该用户身份运行(./data、./cache 归属)
UID=1000
GID=1000
# 只让本机的反向代理(Caddy)访问
MAPSIM_BIND=127.0.0.1

# ---- 站点 ----
MAPSIM_PUBLIC_URL=https://aeonmap.novakitestudio.com
MAPSIM_SITE_OPERATOR=NovaKite Studio
MAPSIM_CONTACT_EMAIL=

# ---- 安全 ----
# 足够长的随机串：openssl rand -hex 32
MAPSIM_ADMIN_TOKEN=
# 不再使用 data/local.key(启动时吊销并删除)；之前的数据在管理后台给"本地"用户填上你的邮箱后用邮箱登录
MAPSIM_LOCAL_TENANT=off
# 源站只经 Cloudflare 访问时为 1，取 CF-Connecting-IP 作为真实客户端地址(限流用)
MAPSIM_TRUST_CF=1
# Cloudflare Zero Trust → Access → Applications 里给 /admin* 建应用后填写(见 README)
MAPSIM_CF_ACCESS_TEAM=
MAPSIM_CF_ACCESS_AUD=

# ---- 邮箱登录(SMTP) ----
# 465 端口用 TLS，其余(587)用 STARTTLS
MAPSIM_SMTP_HOST=
MAPSIM_SMTP_PORT=587
MAPSIM_SMTP_USER=
MAPSIM_SMTP_PASS=
MAPSIM_SMTP_FROM=AeonMap <no-reply@novakitestudio.com>

# ---- Google 登录 ----
# 回调地址填 https://aeonmap.novakitestudio.com/v1/auth/google/callback
MAPSIM_GOOGLE_CLIENT_ID=
MAPSIM_GOOGLE_CLIENT_SECRET=

# ---- 备份(默认每 24 小时一份、保留 7 份，存在 ./data/backups) ----
MAPSIM_BACKUP_HOURS=24
MAPSIM_BACKUP_KEEP=7

# 本地开发才用：没有 SMTP 时把登录链接直接返回。生产环境不要设置
# MAPSIM_AUTH_DEV=1
